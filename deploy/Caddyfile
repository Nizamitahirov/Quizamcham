# SITE_HOST (deploy/.env): domen(lər). Domen yoxdursa "<ip-tirelərlə>.sslip.io" (GitHub Actions avtomatik təyin edir).
# jabr.az bağlananda GitHub-da SITE_HOST dəyişəni: "jabr.az, www.jabr.az" — Caddy SSL sertifikatını özü alır.
(app) {
	encode zstd gzip

	# SEO: bir əsas ünvan — www və ehtiyat (sslip) ünvanlar əsas domenə 301 ilə yönləndirilir (API istisna: deploy yoxlaması)
	@alt {
		host www.jabr.az *.sslip.io
		not path /api/*
	}
	redir @alt https://{$PRIMARY_HOST:jabr.az}{uri} permanent

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		header /robots.txt Cache-Control "public, max-age=3600"
		header /sitemap.xml Cache-Control "public, max-age=3600"
	}

	# Təhlükəsizlik başlıqları: HSTS, CSP (yalnız öz mənbələrimiz; Google girişi yönləndirmə ilə işləyir), icazələr
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss: https://jabr.az https://www.jabr.az; media-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'self'; upgrade-insecure-requests"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}

{$SITE_HOST} {
	import app
}

# IP ilə müraciət: sağlamlıq yoxlaması (serverin özü üçün) + HTTPS ünvana yönləndirmə
:80 {
	handle /api/health {
		reverse_proxy api:3000
	}
	handle {
		redir https://{$SITE_REDIRECT}{uri} permanent
	}
}
