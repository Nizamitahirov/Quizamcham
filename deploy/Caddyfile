# SITE_HOST (deploy/.env): domen(lər). Domen yoxdursa "<ip-tirelərlə>.sslip.io" (GitHub Actions avtomatik təyin edir).
# jabr.az bağlananda GitHub-da SITE_HOST dəyişəni: "jabr.az, www.jabr.az" — Caddy SSL sertifikatını özü alır.
(app) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}

{$SITE_HOST} {
	import app
}

# IP ilə müraciət: sağlamlıq yoxlaması (serverin özü üçün) + HTTPS ünvana yönləndirmə
:80 {
	handle /api/health {
		reverse_proxy api:3000
	}
	handle {
		redir https://{$SITE_REDIRECT}{uri} permanent
	}
}
