rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- Köməkçi funksiyalar ----------
    function signedIn() { return request.auth != null; }
    // ---------- Rollar ----------
    // super admin: platformanın sahibi (nt.nizamitahir@gmail.com) — hesab ID-si ilə sabitlənib, tətbiqdən dəyişdirilə bilməz.
    // admin: təlimçiləri idarə edir, bütün quiz/oyun/analitikanı görür, ayarlar və səslər. Loglar və adminlər — yox.
    // trainer: yalnız öz quizləri (+ kitabxanaya paylaşılanlar), öz oyunları və analitikası.
    // Məhdudlaşdırılmış (disabled) hesab heç bir admin hüququ almır.
    function SUPER() { return 'ii98moHX58SDPcn9lA4SYHWanou1'; }
    function adminDoc() { return /databases/$(db)/documents/admins/$(request.auth.uid); }
    function me() { return get(adminDoc()).data; }
    function isSuper() { return signedIn() && request.auth.uid == SUPER(); }
    function isAdmin() { return isSuper() || (signedIn() && exists(adminDoc()) && me().get('disabled', false) != true); }
    // ---------- İcazələr: rol üzrə standartlar (settings/access — super admin dəyişir) + şəxsə xüsusi istisnalar (admins/{uid}.perms) ----------
    function roleKey() { return me().get('role', 'trainer') in ['admin', 'owner'] ? 'admin' : 'trainer'; }
    function defaultPerm(r, p) {
      return r == 'admin'
        ? p in ['createQuiz', 'runGames', 'library', 'share', 'allContent', 'trainers', 'settings', 'publish']
        : p in ['createQuiz', 'runGames', 'library', 'share'];
    }
    function accessDoc() { return /databases/$(db)/documents/settings/access; }
    function rolePerm(p) { return exists(accessDoc()) ? get(accessDoc()).data.get(roleKey(), {}).get(p, defaultPerm(roleKey(), p)) : defaultPerm(roleKey(), p); }
    // Özü qeydiyyatdan keçən təlimçi (source == 'signup'): sınaq = createdAt (server vaxtı) + 3 gün;
    // super admin trialEndsAt (uzatma) və ya licenseUntil (lisenziya) təyin edə bilər.
    // Müddət bitəndə giriş qalır (öz məzmununa baxır), amma yaratmaq/oyun keçirmək/paylaşmaq bağlanır.
    // Müəssisə: lisenziyası "institution" olan müştəri öz təlimçilərini (source == 'org', orgId == sahibin uid-i) əlavə edir
    function orgLicensed(o) {
      let od = get(/databases/$(db)/documents/admins/$(o)).data;
      return od.get('plan', '') == 'institution' && request.time < od.get('licenseUntil', timestamp.value(0));
    }
    function planOk() {
      let d = me();
      return d.get('source', 'team') == 'org' ? orgLicensed(d.get('orgId', '-'))
        : (d.get('source', 'team') != 'signup'
           || request.time < d.get('licenseUntil', d.get('trialEndsAt', d.get('createdAt', timestamp.value(0)) + duration.value(3, 'd'))));
    }
    // Müştəri (özü qeydiyyatlı və ya müəssisə təlimçisi) platforma üzrə ortaq məkanlara (kitabxana, kataloq) məzmun çıxara bilməz
    function selfServe() { return !isSuper() && exists(adminDoc()) && me().get('source', 'team') in ['signup', 'org']; }
    function isOrgOwner() { return isAdmin() && me().get('source', 'team') == 'signup' && me().get('plan', '') == 'institution' && planOk(); }
    // istifadəçinin təşkilatı: müəssisə təlimçisi → orgId, müəssisə sahibi → öz uid-i, digərləri → ''
    function orgOf() {
      return !isAdmin() ? '' : me().get('source', 'team') == 'org' ? me().get('orgId', '')
        : (me().get('source', 'team') == 'signup' && me().get('plan', '') == 'institution' ? request.auth.uid : '');
    }
    // Pulsuz plan: sınaq/lisenziya bitib → oyunda maksimum 10 iştirakçı
    function freeHost() { return selfServe() && !planOk(); }
    // Plan pillələri (Kahoot modeli): oyunda iştirakçı limiti. Komanda hesabları limitsiz; sınaq = Pro.
    function tierCap(p) { return p == 'trainer' ? 50 : (p in ['business', 'institution'] ? 1000 : 200); }
    function playerCap() {
      return !selfServe() ? 100000
        : !planOk() ? 10
        : me().get('source', 'team') == 'org' ? 1000
        : request.time < me().get('licenseUntil', timestamp.value(0)) ? tierCap(me().get('plan', 'pro'))
        : 200;
    }
    function can(p) {
      return isSuper() || (isAdmin() && me().get('perms', {}).get(p, rolePerm(p)) == true
        && (!(p in ['share', 'publish']) || !selfServe()));
    }
    function registered() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function str(v, n) { return v is string && v.size() <= n; }
    function isOwner() { return can('allContent'); }
    function game(gameId) { return get(/databases/$(db)/documents/games/$(gameId)).data; }
    function isGameHost(gameId) { return isAdmin() && (game(gameId).hostUid == request.auth.uid || isOwner() || (game(gameId).get('orgId', '') == request.auth.uid && isOrgOwner())); }
    function nameOk(v) { return v is string && v.size() >= 2 && v.size() <= 20; }
    function isPlayer(gameId) { return signedIn() && exists(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid)); }
    // Qadağan sözlər (settings/app.bannedWords) — dəqiq uyğunluq; klient daha geniş (hissəvi) yoxlayır
    function bannedList() {
      return exists(/databases/$(db)/documents/settings/app)
        ? get(/databases/$(db)/documents/settings/app).data.get('bannedWords', []) : [];
    }
    function nameAllowed(v) { return !(v.lower() in bannedList()); }
    function answerValueOk(v) {
      return v == null || v is number || (v is string && v.size() <= 200) || (v is list && v.size() <= 10);
    }

    // ---------- Komanda: super admin hamını, admin yalnız təlimçiləri idarə edir ----------
    match /admins/{uid} {
      function newRole() { return request.resource.data.get('role', 'trainer'); }
      function keysOk() {
        return request.resource.data.keys().hasOnly(['email','role','name','createdAt','createdBy','disabled','mustChangePassword','passwordChangedAt','updatedAt','updatedBy','perms','source','trialEndsAt','licenseUntil','plan','seats','orgId'])
          && request.resource.data.get('perms', {}).keys().hasOnly(['createQuiz','runGames','library','share','allContent','trainers','settings','logs','publish','console']);
      }
      function permsUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perms','source','trialEndsAt','licenseUntil','plan','seats','orgId']); }
      allow get: if signedIn() && (request.auth.uid == uid || can('trainers') || resource.data.get('orgId', '') == request.auth.uid
        || (exists(adminDoc()) && me().get('orgId', '') == uid));   // müəssisə təlimçisi sahibin lisenziyasını görür
      allow list: if can('trainers') || (signedIn() && resource.data.get('orgId', '') == request.auth.uid);
      allow create: if keysOk() && uid != SUPER()
        && ((isSuper() && newRole() in ['admin', 'trainer'])
            || (can('trainers') && newRole() == 'trainer' && !('perms' in request.resource.data)
                && !request.resource.data.keys().hasAny(['source','trialEndsAt','licenseUntil','plan']))
            // Google ilə özü qeydiyyatdan keçən təlimçi: yalnız 3 günlük sınaqla, qeydiyyat profilindən sonra
            || (uid == request.auth.uid && request.auth.token.firebase.sign_in_provider == 'google.com'
                && request.resource.data.keys().hasOnly(['email','name','role','source','createdAt','disabled','mustChangePassword'])
                && newRole() == 'trainer' && request.resource.data.source == 'signup'
                && request.resource.data.email == request.auth.token.email
                && request.resource.data.createdAt == request.time
                && request.resource.data.get('disabled', false) == false
                && request.resource.data.get('mustChangePassword', false) == false
                && exists(/databases/$(db)/documents/users/$(uid))
                && get(/databases/$(db)/documents/users/$(uid)).data.type in ['trainer', 'institution'])
            // lisenziyalı müəssisə sahibi öz təlimçisini əlavə edir (ilk girişdə şifrə dəyişmə məcburi)
            || (isOrgOwner() && uid != request.auth.uid
                && request.resource.data.keys().hasOnly(['email','name','role','source','orgId','createdAt','createdBy','disabled','mustChangePassword'])
                && newRole() == 'trainer' && request.resource.data.source == 'org'
                && request.resource.data.orgId == request.auth.uid && request.resource.data.createdBy == request.auth.uid
                && request.resource.data.createdAt == request.time
                && request.resource.data.disabled == false && request.resource.data.mustChangePassword == true));
      allow update: if keysOk() && (
        // super admin öz sənədi: rol dəyişmir, özünü məhdudlaşdıra bilməz
        (uid == SUPER() && isSuper() && newRole() == 'super' && request.resource.data.get('disabled', false) == false)
        // super admin başqalarını (admin/təlimçi) və onların fərdi icazələrini idarə edir
        || (uid != SUPER() && isSuper() && newRole() in ['admin', 'trainer'])
        // "təlimçiləri idarə et" icazəsi olan: yalnız təlimçiləri; rolu yüksəldə, fərdi icazə dəyişə, özünə toxuna bilməz
        || (uid != SUPER() && uid != request.auth.uid && can('trainers') && permsUnchanged()
            && resource.data.get('role', 'trainer') == 'trainer' && newRole() == 'trainer')
        // müəssisə sahibi öz təlimçisini məhdudlaşdırır / adını dəyişir
        || (uid != request.auth.uid && resource.data.get('orgId', '') == request.auth.uid && isOrgOwner()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled','name','updatedAt','updatedBy']))
        // hər kəs ilk girişdə öz şifrəsini dəyişdiyini qeyd edə bilər (yalnız bu iki sahə)
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword','passwordChangedAt'])
            && request.resource.data.mustChangePassword == false)
      );
      allow delete: if uid != SUPER() && (
        (uid != request.auth.uid && (isSuper() || (can('trainers') && resource.data.get('role', 'trainer') == 'trainer')))
        // özü qeydiyyatdan keçən müştəri hesabını silə bilir (komanda üzvü yox)
        || (uid == request.auth.uid && resource.data.get('source', 'team') == 'signup')
        // müəssisə sahibi öz təlimçisini silir
        || (uid != request.auth.uid && isAdmin() && resource.data.get('orgId', '') == request.auth.uid));
    }

    // ---------- Audit jurnalı: kim, nə vaxt, nə etdi (yalnız super admin oxuyur; dəyişdirilə/silinə bilməz) ----------
    match /audit/{id} {
      allow read: if can('logs');
      allow create: if (isAdmin() || (registered() && request.resource.data.action in ['account_deleted', 'data_exported']))
        && request.resource.data.keys().hasOnly(['actor','actorEmail','action','target','targetEmail','details','at'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && (!('details' in request.resource.data) || (request.resource.data.details is map && request.resource.data.details.size() <= 20));
      allow update, delete: if false;
    }

    // ---------- Quizlər: təlimçi öz quizlərini və kitabxanaya paylaşılanları görür; admin hamısını ----------
    // Birgə redaktə: quizin "editors" siyahısındakı e-poçt (kiçik hərflə) — həmmüəllif
    function myEmail() { return request.auth.token.get('email', '') is string ? request.auth.token.get('email', '').lower() : ''; }
    function coEditor(d) { return isAdmin() && myEmail() != '' && d.get('editors', []).hasAny([myEmail()]); }
    match /quizzes/{quizId} {
      // müəssisə daxilində quizlər ortaqdır (orgId), müəssisə sahibi hamısını idarə edir
      allow read: if can('allContent') || (isAdmin() && (resource.data.ownerUid == request.auth.uid || (resource.data.get('shared', false) == true && can('library'))))
        || (orgOf() != '' && resource.data.get('orgId', '') == orgOf()) || coEditor(resource.data);
      allow create: if can('createQuiz') && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.get('shared', false) == false || can('share'))
        && request.resource.data.get('orgId', '') in ['', orgOf()];
      allow update: if isAdmin() && (resource.data.ownerUid == request.auth.uid || isOwner() || (isOrgOwner() && resource.data.get('orgId', '') == request.auth.uid)
            // həmmüəllif: məzmunu dəyişir, amma redaktorlar siyahısına toxuna bilməz
            || (coEditor(resource.data) && request.resource.data.get('editors', []) == resource.data.get('editors', [])))
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('orgId', '') == resource.data.get('orgId', '')
        && (request.resource.data.get('shared', false) == resource.data.get('shared', false) || can('share'));
      allow delete: if isAdmin() && (resource.data.ownerUid == request.auth.uid || isOwner() || (isOrgOwner() && resource.data.get('orgId', '') == request.auth.uid));
      match /questions/{qid} {
        function quizOwner() { return get(/databases/$(db)/documents/quizzes/$(quizId)).data.ownerUid; }
        function quizShared() { return get(/databases/$(db)/documents/quizzes/$(quizId)).data.get('shared', false) == true; }
        function quizOrg() { return get(/databases/$(db)/documents/quizzes/$(quizId)).data.get('orgId', ''); }
        function quizCoEditor() { return exists(/databases/$(db)/documents/quizzes/$(quizId)) && coEditor(get(/databases/$(db)/documents/quizzes/$(quizId)).data); }
        allow read: if can('allContent') || (isAdmin() && (quizOwner() == request.auth.uid || (quizShared() && can('library'))))
          || (orgOf() != '' && quizOrg() == orgOf()) || quizCoEditor();
        allow write: if isAdmin() && (!exists(/databases/$(db)/documents/quizzes/$(quizId)) || quizOwner() == request.auth.uid || isOwner()
          || (isOrgOwner() && quizOrg() == request.auth.uid) || quizCoEditor());
      }
    }

    match /pins/{pin} {
      allow get: if signedIn();          // konkret PIN yoxlanır, siyahılamaq olmur
      allow list: if can('allContent');
      // PIN yalnız həmin oyunun hostuna məxsusdur (başqa təlimçi aktiv PIN-i öz oyununa yönləndirə və ya silə bilməz)
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['gameId', 'active', 'createdAt'])
        && request.resource.data.gameId is string && isGameHost(request.resource.data.gameId);
      allow update: if isAdmin() && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && isGameHost(resource.data.gameId);
      allow delete: if isAdmin() && (isGameHost(resource.data.gameId) || isOwner()
        || !exists(/databases/$(db)/documents/games/$(resource.data.gameId)));
    }

    // settings/app → ümumi ayarlar (yalnız sahib), settings/current → daimi QR (istənilən təlimçi),
    // settings/play_{uid} → həmin təlimçinin şəxsi daimi QR-ı
    // settings/access → rol icazələri (yalnız super admin dəyişir)
    match /settings/{doc} {
      allow get: if signedIn();
      allow list: if can('settings');
      allow write: if (doc == 'access' && isSuper()
            && request.resource.data.keys().hasOnly(['admin', 'trainer', 'updatedAt', 'updatedBy'])
            && request.resource.data.admin.keys().hasOnly(['createQuiz','runGames','library','share','allContent','trainers','settings','logs','publish','console'])
            && request.resource.data.trainer.keys().hasOnly(['createQuiz','runGames','library','share','allContent','trainers','settings','logs','publish','console']))
        || (doc == 'pricing' && can('console'))
        || (!(doc in ['access', 'pricing']) && (can('settings') || (isAdmin() && ((doc == 'current' && !selfServe()) || doc == 'play_' + request.auth.uid))));
    }

    match /sounds/{doc} {            // düz/səhv cavab səs parçaları (yalnız sahib dəyişir)
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if can('settings');
    }

    match /profiles/{uid} {          // təlimçi profili (e-poçt daxil) — özü və admin oxuyur
      allow read: if can('trainers') || can('allContent') || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin() && request.auth.uid == uid;
    }

    // ---------- Qeydiyyatdan keçmiş istifadəçilər (Google) ----------
    match /users/{uid} {
      function own() { return registered() && request.auth.uid == uid; }
      function fieldsOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email','displayName','photoURL','type','firstName','lastName','phone','country','city',
            'sector','position','organization','orgSize','orgType','seats','institution','field','level','year',
            'interests','goal','source','marketing','termsAt','onboarded','createdAt','lastLoginAt','lang',
            'dataConsentAt','marketingAt','consentVersion'])
          && d.type in ['student', 'trainer', 'institution']
          && str(d.get('firstName', ''), 60) && str(d.get('lastName', ''), 60) && str(d.get('phone', ''), 30)
          && str(d.get('organization', ''), 120) && str(d.get('position', ''), 80) && str(d.get('sector', ''), 60)
          && (!('interests' in d) || (d.interests is list && d.interests.size() <= 12));
      }
      allow get: if own() || can('console');
      allow list: if can('console');
      allow create: if own() && fieldsOk() && request.resource.data.createdAt == request.time
        && request.resource.data.email == request.auth.token.email;
      // tip (tələbə/təlimçi) və qeydiyyat tarixi sonradan dəyişmir — sınaq məntiqi buna bağlıdır
      allow update: if own() && fieldsOk()
        && (request.resource.data.type == resource.data.type
            || (resource.data.type == 'student' && request.resource.data.type in ['trainer', 'institution']))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email;
      // konsol: tələbəni təlimçiyə çevirmək (yalnız tip)
      allow update: if can('console') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type'])
        && request.resource.data.type in ['student', 'trainer', 'institution'];
      allow delete: if own() || isSuper();
    }

    // ---------- Razılıq jurnalı (sübut): yalnız əlavə olunur, dəyişdirilmir; hesab silinəndə də qalır (yalnız uid, tip, versiya, tarix) ----------
    match /consents/{id} {
      allow read: if can('console') || (registered() && resource.data.uid == request.auth.uid);
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['uid','type','granted','version','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['data', 'terms', 'marketing']
        && request.resource.data.granted is bool
        && str(request.resource.data.version, 20)
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------- İctimai kataloq: tələbələr limitsiz məşq edir ----------
    // Dərc: publish icazəsi olanlar VƏ ya öz quizini dərc edən istənilən təlimçi (mətn yoxlaması serverdə).
    // Gizlədilmiş (şikayət/moderasiya) dərcləri yalnız konsol icazəsi olan bərpa edir; şəkilli quizlər "review" statusunda gözləyir.
    function ownsQuiz(id) {
      return isAdmin() && can('createQuiz') && exists(/databases/$(db)/documents/quizzes/$(id))
        && get(/databases/$(db)/documents/quizzes/$(id)).data.ownerUid == request.auth.uid;
    }
    function catalogSafe() {
      return request.resource.data.get('hidden', false) == false
        && !(resource != null && resource.data.get('hidden', false) == true)
        && request.resource.data.get('status', 'live') in ['live', 'review']
        && (request.resource.data.get('hasImages', false) == false || request.resource.data.get('status', 'live') == 'review');
    }
    match /catalog/{quizId} {
      allow read: if registered() || isAdmin();
      allow create, update: if (can('console')
            && (request.resource.data.publishedBy == request.auth.uid || (resource != null && request.resource.data.publishedBy == resource.data.publishedBy)))
        || (request.resource.data.publishedBy == request.auth.uid
            && (can('publish') || ownsQuiz(quizId))
            && (resource == null || can('publish') || resource.data.publishedBy == request.auth.uid)
            && catalogSafe());
      allow delete: if can('publish') || can('console') || (isAdmin() && resource.data.publishedBy == request.auth.uid);
    }

    // ---------- Kataloq reytinqi: tələbə 1–5 ulduz verir (bir quizə bir sənəd, dəyişə bilər); orta göstərici server tərəfindən ----------
    match /ratings/{id} {
      allow read: if registered() && resource.data.uid == request.auth.uid;
      allow create, update: if registered() && id == request.resource.data.quizId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'quizId', 'stars', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.at == request.time
        && exists(/databases/$(db)/documents/catalog/$(request.resource.data.quizId));
      allow delete: if false;
    }
    match /ratingStats/{quizId} {
      allow read: if registered() || isAdmin();
      allow write: if false; // yalnız server (orta qiymət) yazır
    }

    // ---------- Şikayətlər (tələbə → kataloqdakı quiz). 3 şikayət → server quizi avtomatik gizlədir ----------
    match /reports/{id} {
      allow create: if registered()
        && id == request.resource.data.quizId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'quizId', 'reason', 'note', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason in ['language', 'sexual', 'hate', 'wrong', 'spam', 'other']
        && str(request.resource.data.get('note', ''), 300)
        && request.resource.data.at == request.time
        && exists(/databases/$(db)/documents/catalog/$(request.resource.data.quizId));
      allow read, delete: if can('console');
      allow update: if false;
    }

    // ---------- Məşq nəticələri ----------
    match /attempts/{id} {
      allow read: if (registered() && resource.data.uid == request.auth.uid) || can('console');
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['uid','quizId','quizTitle','correct','total','score','durationMs','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 200
        && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
        && str(request.resource.data.quizTitle, 120)
        && exists(/databases/$(db)/documents/catalog/$(request.resource.data.quizId));
      allow update: if false;
      allow delete: if registered() && resource.data.uid == request.auth.uid;
    }

    // ---------- Siniflər (qruplar): təlimçi yaradır, tələbə kodla qoşulur, tapşırıqlar və nəticələr ----------
    function classDoc(cid) { return get(/databases/$(db)/documents/classes/$(cid)).data; }
    function classOwner(cid) { return isAdmin() && exists(/databases/$(db)/documents/classes/$(cid)) && classDoc(cid).ownerUid == request.auth.uid; }
    function classMember(cid) { return registered() && exists(/databases/$(db)/documents/classes/$(cid)/members/$(request.auth.uid)); }
    match /classes/{cid} {
      allow get: if classOwner(cid) || classMember(cid) || can('allContent');
      allow list: if (isAdmin() && resource.data.ownerUid == request.auth.uid) || can('allContent');
      allow create: if isAdmin() && can('createQuiz') && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','name','code','createdAt','archived','ownerName'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() >= 2
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.createdAt == request.time;
      allow update: if classOwner(cid) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.code == resource.data.code
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','archived','ownerName']) && str(request.resource.data.name, 80);
      allow delete: if classOwner(cid);
      match /members/{uid} {
        allow read: if classOwner(cid) || (registered() && request.auth.uid == uid);
        allow create: if registered() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','name','email','code','joinedAt'])
          && request.resource.data.uid == uid && str(request.resource.data.name, 80) && str(request.resource.data.get('email', ''), 120)
          && request.resource.data.code == classDoc(cid).code && classDoc(cid).get('archived', false) == false
          && request.resource.data.joinedAt == request.time;
        allow update: if false;
        allow delete: if classOwner(cid) || (registered() && request.auth.uid == uid);
      }
      match /tasks/{tid} {
        allow read: if classOwner(cid) || classMember(cid);
        allow create, update: if classOwner(cid)
          && request.resource.data.keys().hasOnly(['kind','title','quizId','courseId','gameId','pin','dueAt','createdAt','note'])
          && request.resource.data.kind in ['practice', 'course', 'game'] && str(request.resource.data.title, 120) && str(request.resource.data.get('note', ''), 300);
        allow delete: if classOwner(cid);
      }
      match /results/{rid} {
        allow read: if classOwner(cid) || (registered() && resource.data.uid == request.auth.uid);
        allow create, update: if classMember(cid) && rid == request.auth.uid + '_' + request.resource.data.taskId
          && request.resource.data.keys().hasOnly(['uid','name','taskId','score','correct','total','pct','at'])
          && request.resource.data.uid == request.auth.uid && str(request.resource.data.name, 80)
          && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 200
          && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total
          && request.resource.data.pct is int && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
          && request.resource.data.at == request.time
          && exists(/databases/$(db)/documents/classes/$(cid)/tasks/$(request.resource.data.taskId));
        allow delete: if classOwner(cid);
      }
    }
    // Sinif kodu → sinif (PIN kimi: konkret kodu bilən oxuyur, siyahı yoxdur)
    match /classCodes/{code} {
      allow get: if registered() || isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['classId']) && classOwner(request.resource.data.classId);
      allow delete: if isAdmin() && classOwner(resource.data.classId);
    }
    // Tələbənin üzvlükləri (öz siniflərinin siyahısı üçün), id = uid_classId
    match /memberships/{id} {
      allow read: if registered() && resource.data.uid == request.auth.uid;
      allow create: if registered() && id == request.auth.uid + '_' + request.resource.data.classId
        && request.resource.data.keys().hasOnly(['uid','classId','className','joinedAt'])
        && request.resource.data.uid == request.auth.uid && str(request.resource.data.className, 80)
        && request.resource.data.joinedAt == request.time
        && exists(/databases/$(db)/documents/classes/$(request.resource.data.classId)/members/$(request.auth.uid));
      allow delete: if registered() && resource.data.uid == request.auth.uid;
    }

    // ---------- Kurslar: kataloq quizlərinin ardıcıllığı + tələbənin irəliləyişi ----------
    match /courses/{courseId} {
      allow read: if registered() || isAdmin();
      allow create, update: if isAdmin() && can('createQuiz') && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid','ownerName','title','description','items','createdAt','updatedAt','coverEmoji'])
        && str(request.resource.data.title, 120) && request.resource.data.title.size() >= 3 && str(request.resource.data.get('description', ''), 500)
        && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 50;
      allow delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
      match /progress/{uid} {
        allow read: if (registered() && request.auth.uid == uid) || (isAdmin() && get(/databases/$(db)/documents/courses/$(courseId)).data.ownerUid == request.auth.uid);
        allow create, update: if registered() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','name','done','completedAt','at'])
          && request.resource.data.uid == uid && request.resource.data.done is list && request.resource.data.done.size() <= 50
          && request.resource.data.at == request.time;
        allow delete: if false;
      }
    }

    // ---------- Qeydiyyatlı istifadəçinin canlı oyun tarixçəsi (id = uid_gameId) ----------
    match /plays/{id} {
      allow read: if (registered() && resource.data.uid == request.auth.uid) || can('console');
      allow create: if registered()
        && id == request.auth.uid + '_' + request.resource.data.gameId
        && request.resource.data.keys().hasOnly(['uid','gameId','title','rank','total','score','correct','questions','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && str(request.resource.data.title, 120)
        && request.resource.data.score is int && request.resource.data.rank is int
        && exists(/databases/$(db)/documents/games/$(request.resource.data.gameId)/players/$(request.auth.uid));
      allow update: if false;
      allow delete: if registered() && resource.data.uid == request.auth.uid;
    }

    // ---------- Lisenziya qeydləri (tarixçə və gəlir) ----------
    match /licenses/{id} {
      allow read: if can('console');
      allow create: if can('console')
        && request.resource.data.keys().hasOnly(['uid','email','plan','seats','from','until','amount','currency','note','by','at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.plan in ['trainer', 'pro', 'business', 'institution', 'revoked']
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && str(request.resource.data.get('note', ''), 300);
      allow update, delete: if isSuper();
    }

    // ---------- Lisenziya müraciətləri (satış) ----------
    match /licenseRequests/{id} {
      allow read: if can('console') || (registered() && resource.data.uid == request.auth.uid);
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['uid','email','name','phone','organization','plan','seats','message','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.plan in ['trainer', 'pro', 'business', 'institution', 'event', 'custom']
        && str(request.resource.data.name, 80) && str(request.resource.data.phone, 30) && str(request.resource.data.get('message', ''), 1000)
        && str(request.resource.data.get('organization', ''), 120);
      allow update: if can('console')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','note','updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'won', 'lost'];
      allow delete: if isSuper() || (registered() && resource.data.uid == request.auth.uid);
    }

    match /errors/{id} {             // klient xəta jurnalı (yalnız yazılır, super admin oxuyur)
      allow read, delete: if can('logs');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message','stack','url','ua','uid','at','context'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && (!('stack' in request.resource.data) || request.resource.data.stack.size() <= 4000)
        && request.resource.data.at == request.time;
    }

    // ---------- Oyunlar ----------
    match /games/{gameId} {
      // Siyahını yalnız adminlər görür. Konkret oyun: aktivdirsə hər kəs (qoşulmaq üçün),
      // bitibsə yalnız onun iştirakçıları — adlar və nəticələr kənar şəxslərə açılmır.
      // Siyahı: admin hamısını, təlimçi yalnız özünün (sorğu hostUid ilə süzülməlidir)
      allow list: if can('allContent') || (isAdmin() && resource.data.hostUid == request.auth.uid)
        || (isOrgOwner() && resource.data.get('orgId', '') == request.auth.uid);
      allow get: if can('allContent') || (isAdmin() && resource.data.hostUid == request.auth.uid) || isPlayer(gameId) || (signedIn() && resource.data.phase != 'finished')
        || (isOrgOwner() && resource.data.get('orgId', '') == request.auth.uid);
      allow create: if can('runGames') && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.get('orgId', '') in ['', orgOf()]
        && request.resource.data.settings.get('maxPlayers', 200) <= playerCap();
      allow update: if isAdmin() && (resource.data.hostUid == request.auth.uid || isOwner() || (isOrgOwner() && resource.data.get('orgId', '') == request.auth.uid))
        // iştirakçı limitini plandan yuxarı qaldırmaq olmaz (əvvəl başlamış oyun pozulmur — azaltmaq/saxlamaq olar)
        && (request.resource.data.settings.get('maxPlayers', 200) <= playerCap()
            || request.resource.data.settings.get('maxPlayers', 200) <= resource.data.settings.get('maxPlayers', 200));
      allow delete: if isAdmin() && (resource.data.hostUid == request.auth.uid || isOwner() || (isOrgOwner() && resource.data.get('orgId', '') == request.auth.uid));

      match /secret/{doc} { allow read, write: if isGameHost(gameId); }

      match /players/{uid} {
        allow read: if isGameHost(gameId) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && game(gameId).locked == false
          && game(gameId).phase != 'finished'
          && (game(gameId).phase == 'lobby' || game(gameId).settings.lateJoin == true)
          && nameOk(request.resource.data.firstName)
          && nameOk(request.resource.data.lastName)
          && (game(gameId).settings.get('nameFilter', true) == false || (nameAllowed(request.resource.data.firstName) && nameAllowed(request.resource.data.lastName)))
          && game(gameId).get('playerCount', 0) < game(gameId).settings.get('maxPlayers', 200)
          && request.resource.data.avatar is map
          && request.resource.data.keys().hasOnly(['firstName','lastName','avatar','joinedAt','lastSeen','kicked','score','correctCount','streak','bestStreak','totalCorrectTimeMs','lastResult','history','powerups','power','fiftyHide','team'])
          && request.resource.data.score == 0
          && request.resource.data.correctCount == 0
          && request.resource.data.history.size() == 0
          && (!('fiftyHide' in request.resource.data) || request.resource.data.fiftyHide == null)
          && (!('powerups' in request.resource.data) || (request.resource.data.powerups.fifty <= 1 && request.resource.data.powerups.double <= 1 && request.resource.data.powerups.shield <= 1))
          && (!('team' in request.resource.data) || (request.resource.data.team is int && request.resource.data.team >= 0 && request.resource.data.team < 4))
          && request.resource.data.kicked == false;
        // oyunçu yalnız heartbeat, güc artırıcı seçimi və (yalnız lobbidə) profilini dəyişə bilər; xalları host yazır
        allow update: if isGameHost(gameId) || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','avatar','lastSeen','power'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstName','lastName','avatar']) || game(gameId).phase == 'lobby')
          && nameOk(request.resource.data.firstName)
          && nameOk(request.resource.data.lastName)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['power']) || request.resource.data.power == null
              || (request.resource.data.power.type in ['fifty','double','shield']
                  && (request.resource.data.power.q == game(gameId).questionIndex
                      || (game(gameId).phase == 'self' && request.resource.data.power.q is int && request.resource.data.power.q < game(gameId).totalQuestions)))));
        allow delete: if isGameHost(gameId);
      }

      // öz tempində / tapşırıq: sualın başlama vaxtı (bir dəfə);
      // canlı rejimdə: sualı gec görən iştirakçının qeydi (host sürət xalını ən çox 5 s güzəştlə hesablayır)
      match /starts/{startId} {
        allow read: if isGameHost(gameId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && startId == request.auth.uid + '_' + string(request.resource.data.q)
          && request.resource.data.keys().hasOnly(['uid','q','startedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.startedAt == request.time
          && request.resource.data.q is int && request.resource.data.q >= 0 && request.resource.data.q < game(gameId).totalQuestions
          && (
            (game(gameId).phase == 'self' && request.time <= game(gameId).selfEndsAt)
            || (game(gameId).phase in ['countdown', 'question']
                && request.resource.data.q == game(gameId).questionIndex
                && isPlayer(gameId))
          );
        allow update: if false;
        allow delete: if isGameHost(gameId);   // oyun silinəndə host təmizləyir
      }

      match /answers/{answerId} {
        allow read: if isGameHost(gameId);
        allow create: if signedIn()
          && answerId == request.auth.uid + '_' + string(request.resource.data.questionIndex)
          && request.resource.data.keys().hasOnly(['uid','questionIndex','value','answeredAt','conf'])
          && request.resource.data.get('conf', false) is bool
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.answeredAt == request.time
          && answerValueOk(request.resource.data.value)
          && exists(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid))
          && get(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid)).data.kicked == false
          && (
            // sual oxuma mərhələsində planlaşdırılır: başlama anından (2 s saat fərqi ehtiyatı ilə) bitmə + 2 s-ə qədər
            (game(gameId).phase in ['countdown', 'question']
              && request.resource.data.questionIndex == game(gameId).questionIndex
              && game(gameId).questionEndsAt != null
              && game(gameId).questionStartedAt != null
              && request.time >= game(gameId).questionStartedAt - duration.value(2, 's')
              && request.time <= game(gameId).questionEndsAt + duration.value(2, 's'))
            || (game(gameId).phase == 'self'
              && request.time <= game(gameId).selfEndsAt + duration.value(5, 's')
              && exists(/databases/$(db)/documents/games/$(gameId)/starts/$(answerId)))
          );
        allow update: if false;
        allow delete: if isGameHost(gameId);   // oyun silinəndə host təmizləyir
      }

      // Reaksiyalar: sənəd id-si = uid_<2 saniyəlik pəncərə> → oyunçu başına 2 saniyədə ən çox 1
      match /reactions/{rid} {
        allow delete: if isGameHost(gameId);
        function bucket() { return int(request.time.toMillis() / 2000); }
        allow read, delete: if isGameHost(gameId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid','emoji','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
          && request.resource.data.createdAt == request.time
          && isPlayer(gameId)
          && (rid == request.auth.uid + '_' + string(bucket()) || rid == request.auth.uid + '_' + string(bucket() - 1));
      }

      // Canlı sual-cavab (Q&A)
      // Q&A: yalnız iştirakçılar; sənəd id-si = uid_<10 saniyəlik pəncərə> → 10 saniyədə ən çox 1 sual
      match /qa/{qid} {
        function qaBucket() { return int(request.time.toMillis() / 10000); }
        allow read: if isGameHost(gameId) || isPlayer(gameId);
        allow create: if isPlayer(gameId)
          && (qid == request.auth.uid + '_' + string(qaBucket()) || qid == request.auth.uid + '_' + string(qaBucket() - 1))
          && request.resource.data.keys().hasOnly(['uid','name','text','createdAt','votes','answered','hidden'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 200
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt == request.time
          && request.resource.data.votes.size() == 0
          && request.resource.data.answered == false && request.resource.data.hidden == false
          && game(gameId).phase != 'finished';
        // oyunçu yalnız öz səsini əlavə edə/silə bilər
        allow update: if isGameHost(gameId) || (isPlayer(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes.toSet().difference(resource.data.votes.toSet()).union(resource.data.votes.toSet().difference(request.resource.data.votes.toSet())) == [request.auth.uid].toSet());
        allow delete: if isGameHost(gameId);
      }

      // Oyun sonu sual icmalı (düzgün cavablarla) — yalnız iştirakçılar və host
      match /results/{doc} {
        allow read: if isGameHost(gameId) || isPlayer(gameId);
        allow write: if isGameHost(gameId);
      }

      // Təlim sonu rəy sorğusu
      match /feedback/{uid} {
        allow delete: if isGameHost(gameId);
        allow read: if isGameHost(gameId);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rating','comment','name','at'])
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500))
          && request.resource.data.at == request.time
          && exists(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid));
      }
    }
  }
}
