rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- Köməkçi funksiyalar ----------
    function signedIn() { return request.auth != null; }
    // ---------- Rollar ----------
    // super admin: platformanın sahibi (nt.nizamitahir@gmail.com) — hesab ID-si ilə sabitlənib, tətbiqdən dəyişdirilə bilməz.
    // admin: təlimçiləri idarə edir, bütün quiz/oyun/analitikanı görür, ayarlar və səslər. Loglar və adminlər — yox.
    // trainer: yalnız öz quizləri (+ kitabxanaya paylaşılanlar), öz oyunları və analitikası.
    // Məhdudlaşdırılmış (disabled) hesab heç bir admin hüququ almır.
    function SUPER() { return 'ii98moHX58SDPcn9lA4SYHWanou1'; }
    function adminDoc() { return /databases/$(db)/documents/admins/$(request.auth.uid); }
    function me() { return get(adminDoc()).data; }
    function isSuper() { return signedIn() && request.auth.uid == SUPER(); }
    function isAdmin() { return isSuper() || (signedIn() && exists(adminDoc()) && me().get('disabled', false) != true); }
    // ---------- İcazələr: rol üzrə standartlar (settings/access — super admin dəyişir) + şəxsə xüsusi istisnalar (admins/{uid}.perms) ----------
    function roleKey() { return me().get('role', 'trainer') in ['admin', 'owner'] ? 'admin' : 'trainer'; }
    function defaultPerm(r, p) {
      return r == 'admin'
        ? p in ['createQuiz', 'runGames', 'library', 'share', 'allContent', 'trainers', 'settings', 'publish']
        : p in ['createQuiz', 'runGames', 'library', 'share'];
    }
    function accessDoc() { return /databases/$(db)/documents/settings/access; }
    function rolePerm(p) { return exists(accessDoc()) ? get(accessDoc()).data.get(roleKey(), {}).get(p, defaultPerm(roleKey(), p)) : defaultPerm(roleKey(), p); }
    // Özü qeydiyyatdan keçən təlimçi (source == 'signup'): sınaq = createdAt (server vaxtı) + 3 gün;
    // super admin trialEndsAt (uzatma) və ya licenseUntil (lisenziya) təyin edə bilər.
    // Müddət bitəndə giriş qalır (öz məzmununa baxır), amma yaratmaq/oyun keçirmək/paylaşmaq bağlanır.
    function planOk() {
      let d = me();
      return d.get('source', 'team') != 'signup'
        || request.time < d.get('licenseUntil', d.get('trialEndsAt', d.get('createdAt', timestamp.value(0)) + duration.value(3, 'd')));
    }
    function can(p) {
      return isSuper() || (isAdmin() && me().get('perms', {}).get(p, rolePerm(p)) == true
        && (!(p in ['createQuiz', 'runGames', 'share', 'publish']) || planOk()));
    }
    function registered() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function str(v, n) { return v is string && v.size() <= n; }
    function isOwner() { return can('allContent'); }
    function game(gameId) { return get(/databases/$(db)/documents/games/$(gameId)).data; }
    function isGameHost(gameId) { return isAdmin() && (game(gameId).hostUid == request.auth.uid || isOwner()); }
    function nameOk(v) { return v is string && v.size() >= 2 && v.size() <= 20; }
    function isPlayer(gameId) { return signedIn() && exists(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid)); }
    // Qadağan sözlər (settings/app.bannedWords) — dəqiq uyğunluq; klient daha geniş (hissəvi) yoxlayır
    function bannedList() {
      return exists(/databases/$(db)/documents/settings/app)
        ? get(/databases/$(db)/documents/settings/app).data.get('bannedWords', []) : [];
    }
    function nameAllowed(v) { return !(v.lower() in bannedList()); }
    function answerValueOk(v) {
      return v == null || v is number || (v is string && v.size() <= 200) || (v is list && v.size() <= 10);
    }

    // ---------- Komanda: super admin hamını, admin yalnız təlimçiləri idarə edir ----------
    match /admins/{uid} {
      function newRole() { return request.resource.data.get('role', 'trainer'); }
      function keysOk() {
        return request.resource.data.keys().hasOnly(['email','role','name','createdAt','createdBy','disabled','mustChangePassword','passwordChangedAt','updatedAt','updatedBy','perms','source','trialEndsAt','licenseUntil','plan'])
          && request.resource.data.get('perms', {}).keys().hasOnly(['createQuiz','runGames','library','share','allContent','trainers','settings','logs','publish','console']);
      }
      function permsUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perms','source','trialEndsAt','licenseUntil','plan']); }
      allow get: if signedIn() && (request.auth.uid == uid || can('trainers'));
      allow list: if can('trainers');
      allow create: if keysOk() && uid != SUPER()
        && ((isSuper() && newRole() in ['admin', 'trainer'])
            || (can('trainers') && newRole() == 'trainer' && !('perms' in request.resource.data)
                && !request.resource.data.keys().hasAny(['source','trialEndsAt','licenseUntil','plan']))
            // Google ilə özü qeydiyyatdan keçən təlimçi: yalnız 3 günlük sınaqla, qeydiyyat profilindən sonra
            || (uid == request.auth.uid && request.auth.token.firebase.sign_in_provider == 'google.com'
                && request.resource.data.keys().hasOnly(['email','name','role','source','createdAt','disabled','mustChangePassword'])
                && newRole() == 'trainer' && request.resource.data.source == 'signup'
                && request.resource.data.email == request.auth.token.email
                && request.resource.data.createdAt == request.time
                && request.resource.data.get('disabled', false) == false
                && request.resource.data.get('mustChangePassword', false) == false
                && exists(/databases/$(db)/documents/users/$(uid))
                && get(/databases/$(db)/documents/users/$(uid)).data.type in ['trainer', 'institution']));
      allow update: if keysOk() && (
        // super admin öz sənədi: rol dəyişmir, özünü məhdudlaşdıra bilməz
        (uid == SUPER() && isSuper() && newRole() == 'super' && request.resource.data.get('disabled', false) == false)
        // super admin başqalarını (admin/təlimçi) və onların fərdi icazələrini idarə edir
        || (uid != SUPER() && isSuper() && newRole() in ['admin', 'trainer'])
        // "təlimçiləri idarə et" icazəsi olan: yalnız təlimçiləri; rolu yüksəldə, fərdi icazə dəyişə, özünə toxuna bilməz
        || (uid != SUPER() && uid != request.auth.uid && can('trainers') && permsUnchanged()
            && resource.data.get('role', 'trainer') == 'trainer' && newRole() == 'trainer')
        // hər kəs ilk girişdə öz şifrəsini dəyişdiyini qeyd edə bilər (yalnız bu iki sahə)
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword','passwordChangedAt'])
            && request.resource.data.mustChangePassword == false)
      );
      allow delete: if uid != SUPER() && uid != request.auth.uid
        && (isSuper() || (can('trainers') && resource.data.get('role', 'trainer') == 'trainer'));
    }

    // ---------- Audit jurnalı: kim, nə vaxt, nə etdi (yalnız super admin oxuyur; dəyişdirilə/silinə bilməz) ----------
    match /audit/{id} {
      allow read: if can('logs');
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actor','actorEmail','action','target','targetEmail','details','at'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && (!('details' in request.resource.data) || (request.resource.data.details is map && request.resource.data.details.size() <= 20));
      allow update, delete: if false;
    }

    // ---------- Quizlər: təlimçi öz quizlərini və kitabxanaya paylaşılanları görür; admin hamısını ----------
    match /quizzes/{quizId} {
      allow read: if can('allContent') || (isAdmin() && (resource.data.ownerUid == request.auth.uid || (resource.data.get('shared', false) == true && can('library'))));
      allow create: if can('createQuiz') && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.get('shared', false) == false || can('share'));
      allow update: if isAdmin() && (resource.data.ownerUid == request.auth.uid || isOwner())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (request.resource.data.get('shared', false) == resource.data.get('shared', false) || can('share'));
      allow delete: if isAdmin() && (resource.data.ownerUid == request.auth.uid || isOwner());
      match /questions/{qid} {
        function quizOwner() { return get(/databases/$(db)/documents/quizzes/$(quizId)).data.ownerUid; }
        function quizShared() { return get(/databases/$(db)/documents/quizzes/$(quizId)).data.get('shared', false) == true; }
        allow read: if can('allContent') || (isAdmin() && (quizOwner() == request.auth.uid || (quizShared() && can('library'))));
        allow write: if isAdmin() && (!exists(/databases/$(db)/documents/quizzes/$(quizId)) || quizOwner() == request.auth.uid || isOwner());
      }
    }

    match /pins/{pin} {
      allow get: if signedIn();          // konkret PIN yoxlanır, siyahılamaq olmur
      allow list: if can('allContent');
      allow write: if isAdmin();
    }

    // settings/app → ümumi ayarlar (yalnız sahib), settings/current → daimi QR (istənilən təlimçi),
    // settings/play_{uid} → həmin təlimçinin şəxsi daimi QR-ı
    // settings/access → rol icazələri (yalnız super admin dəyişir)
    match /settings/{doc} {
      allow get: if signedIn();
      allow list: if can('settings');
      allow write: if (doc == 'access' && isSuper()
            && request.resource.data.keys().hasOnly(['admin', 'trainer', 'updatedAt', 'updatedBy'])
            && request.resource.data.admin.keys().hasOnly(['createQuiz','runGames','library','share','allContent','trainers','settings','logs','publish','console'])
            && request.resource.data.trainer.keys().hasOnly(['createQuiz','runGames','library','share','allContent','trainers','settings','logs','publish','console']))
        || (doc == 'pricing' && can('console'))
        || (!(doc in ['access', 'pricing']) && (can('settings') || (isAdmin() && (doc == 'current' || doc == 'play_' + request.auth.uid))));
    }

    match /sounds/{doc} {            // düz/səhv cavab səs parçaları (yalnız sahib dəyişir)
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if can('settings');
    }

    match /profiles/{uid} {          // təlimçi profili (e-poçt daxil) — özü və admin oxuyur
      allow read: if can('trainers') || can('allContent') || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin() && request.auth.uid == uid;
    }

    // ---------- Qeydiyyatdan keçmiş istifadəçilər (Google) ----------
    match /users/{uid} {
      function own() { return registered() && request.auth.uid == uid; }
      function fieldsOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email','displayName','photoURL','type','firstName','lastName','phone','country','city',
            'sector','position','organization','orgSize','orgType','seats','institution','field','level','year',
            'interests','goal','source','marketing','termsAt','onboarded','createdAt','lastLoginAt','lang'])
          && d.type in ['student', 'trainer', 'institution']
          && str(d.get('firstName', ''), 60) && str(d.get('lastName', ''), 60) && str(d.get('phone', ''), 30)
          && str(d.get('organization', ''), 120) && str(d.get('position', ''), 80) && str(d.get('sector', ''), 60)
          && (!('interests' in d) || (d.interests is list && d.interests.size() <= 12));
      }
      allow get: if own() || can('console');
      allow list: if can('console');
      allow create: if own() && fieldsOk() && request.resource.data.createdAt == request.time
        && request.resource.data.email == request.auth.token.email;
      // tip (tələbə/təlimçi) və qeydiyyat tarixi sonradan dəyişmir — sınaq məntiqi buna bağlıdır
      allow update: if own() && fieldsOk()
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email;
      allow delete: if isSuper();
    }

    // ---------- İctimai kataloq: tələbələr limitsiz məşq edir ----------
    match /catalog/{quizId} {
      allow read: if registered() || isAdmin();
      allow create, update: if can('publish') && request.resource.data.publishedBy == request.auth.uid;
      allow delete: if can('publish');
    }

    // ---------- Məşq nəticələri ----------
    match /attempts/{id} {
      allow read: if (registered() && resource.data.uid == request.auth.uid) || can('console');
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['uid','quizId','quizTitle','correct','total','score','durationMs','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 200
        && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
        && str(request.resource.data.quizTitle, 120)
        && exists(/databases/$(db)/documents/catalog/$(request.resource.data.quizId));
      allow update, delete: if false;
    }

    // ---------- Lisenziya müraciətləri (satış) ----------
    match /licenseRequests/{id} {
      allow read: if can('console');
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['uid','email','name','phone','organization','plan','seats','message','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.plan in ['trainer', 'institution', 'custom']
        && str(request.resource.data.name, 80) && str(request.resource.data.phone, 30) && str(request.resource.data.get('message', ''), 1000)
        && str(request.resource.data.get('organization', ''), 120);
      allow update: if can('console')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','note','updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'won', 'lost'];
      allow delete: if isSuper();
    }

    match /errors/{id} {             // klient xəta jurnalı (yalnız yazılır, super admin oxuyur)
      allow read, delete: if can('logs');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message','stack','url','ua','uid','at','context'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && (!('stack' in request.resource.data) || request.resource.data.stack.size() <= 4000)
        && request.resource.data.at == request.time;
    }

    // ---------- Oyunlar ----------
    match /games/{gameId} {
      // Siyahını yalnız adminlər görür. Konkret oyun: aktivdirsə hər kəs (qoşulmaq üçün),
      // bitibsə yalnız onun iştirakçıları — adlar və nəticələr kənar şəxslərə açılmır.
      // Siyahı: admin hamısını, təlimçi yalnız özünün (sorğu hostUid ilə süzülməlidir)
      allow list: if can('allContent') || (isAdmin() && resource.data.hostUid == request.auth.uid);
      allow get: if can('allContent') || (isAdmin() && resource.data.hostUid == request.auth.uid) || isPlayer(gameId) || (signedIn() && resource.data.phase != 'finished');
      allow create: if can('runGames') && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if isAdmin() && (resource.data.hostUid == request.auth.uid || isOwner());

      match /secret/{doc} { allow read, write: if isGameHost(gameId); }

      match /players/{uid} {
        allow read: if isGameHost(gameId) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && game(gameId).locked == false
          && game(gameId).phase != 'finished'
          && (game(gameId).phase == 'lobby' || game(gameId).settings.lateJoin == true)
          && nameOk(request.resource.data.firstName)
          && nameOk(request.resource.data.lastName)
          && (game(gameId).settings.get('nameFilter', true) == false || (nameAllowed(request.resource.data.firstName) && nameAllowed(request.resource.data.lastName)))
          && game(gameId).get('playerCount', 0) < game(gameId).settings.get('maxPlayers', 200)
          && request.resource.data.avatar is map
          && request.resource.data.keys().hasOnly(['firstName','lastName','avatar','joinedAt','lastSeen','kicked','score','correctCount','streak','bestStreak','totalCorrectTimeMs','lastResult','history','powerups','power','fiftyHide','team'])
          && request.resource.data.score == 0
          && request.resource.data.correctCount == 0
          && request.resource.data.history.size() == 0
          && (!('fiftyHide' in request.resource.data) || request.resource.data.fiftyHide == null)
          && (!('powerups' in request.resource.data) || (request.resource.data.powerups.fifty <= 1 && request.resource.data.powerups.double <= 1 && request.resource.data.powerups.shield <= 1))
          && (!('team' in request.resource.data) || (request.resource.data.team is int && request.resource.data.team >= 0 && request.resource.data.team < 4))
          && request.resource.data.kicked == false;
        // oyunçu yalnız heartbeat, güc artırıcı seçimi və (yalnız lobbidə) profilini dəyişə bilər; xalları host yazır
        allow update: if isGameHost(gameId) || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','avatar','lastSeen','power'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstName','lastName','avatar']) || game(gameId).phase == 'lobby')
          && nameOk(request.resource.data.firstName)
          && nameOk(request.resource.data.lastName)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['power']) || request.resource.data.power == null
              || (request.resource.data.power.type in ['fifty','double','shield']
                  && (request.resource.data.power.q == game(gameId).questionIndex
                      || (game(gameId).phase == 'self' && request.resource.data.power.q is int && request.resource.data.power.q < game(gameId).totalQuestions)))));
        allow delete: if isGameHost(gameId);
      }

      // öz tempində / tapşırıq: sualın başlama vaxtı (bir dəfə);
      // canlı rejimdə: sualı gec görən iştirakçının qeydi (host sürət xalını ən çox 5 s güzəştlə hesablayır)
      match /starts/{startId} {
        allow read: if isGameHost(gameId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && startId == request.auth.uid + '_' + string(request.resource.data.q)
          && request.resource.data.keys().hasOnly(['uid','q','startedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.startedAt == request.time
          && request.resource.data.q is int && request.resource.data.q >= 0 && request.resource.data.q < game(gameId).totalQuestions
          && (
            (game(gameId).phase == 'self' && request.time <= game(gameId).selfEndsAt)
            || (game(gameId).phase in ['countdown', 'question']
                && request.resource.data.q == game(gameId).questionIndex
                && isPlayer(gameId))
          );
        allow update: if false;
        allow delete: if isGameHost(gameId);   // oyun silinəndə host təmizləyir
      }

      match /answers/{answerId} {
        allow read: if isGameHost(gameId);
        allow create: if signedIn()
          && answerId == request.auth.uid + '_' + string(request.resource.data.questionIndex)
          && request.resource.data.keys().hasOnly(['uid','questionIndex','value','answeredAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.answeredAt == request.time
          && answerValueOk(request.resource.data.value)
          && exists(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid))
          && get(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid)).data.kicked == false
          && (
            // sual oxuma mərhələsində planlaşdırılır: başlama anından (2 s saat fərqi ehtiyatı ilə) bitmə + 2 s-ə qədər
            (game(gameId).phase in ['countdown', 'question']
              && request.resource.data.questionIndex == game(gameId).questionIndex
              && game(gameId).questionEndsAt != null
              && game(gameId).questionStartedAt != null
              && request.time >= game(gameId).questionStartedAt - duration.value(2, 's')
              && request.time <= game(gameId).questionEndsAt + duration.value(2, 's'))
            || (game(gameId).phase == 'self'
              && request.time <= game(gameId).selfEndsAt + duration.value(5, 's')
              && exists(/databases/$(db)/documents/games/$(gameId)/starts/$(answerId)))
          );
        allow update: if false;
        allow delete: if isGameHost(gameId);   // oyun silinəndə host təmizləyir
      }

      // Reaksiyalar: sənəd id-si = uid_<2 saniyəlik pəncərə> → oyunçu başına 2 saniyədə ən çox 1
      match /reactions/{rid} {
        allow delete: if isGameHost(gameId);
        function bucket() { return int(request.time.toMillis() / 2000); }
        allow read, delete: if isGameHost(gameId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid','emoji','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
          && request.resource.data.createdAt == request.time
          && isPlayer(gameId)
          && (rid == request.auth.uid + '_' + string(bucket()) || rid == request.auth.uid + '_' + string(bucket() - 1));
      }

      // Canlı sual-cavab (Q&A)
      // Q&A: yalnız iştirakçılar; sənəd id-si = uid_<10 saniyəlik pəncərə> → 10 saniyədə ən çox 1 sual
      match /qa/{qid} {
        function qaBucket() { return int(request.time.toMillis() / 10000); }
        allow read: if isGameHost(gameId) || isPlayer(gameId);
        allow create: if isPlayer(gameId)
          && (qid == request.auth.uid + '_' + string(qaBucket()) || qid == request.auth.uid + '_' + string(qaBucket() - 1))
          && request.resource.data.keys().hasOnly(['uid','name','text','createdAt','votes','answered','hidden'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 200
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt == request.time
          && request.resource.data.votes.size() == 0
          && request.resource.data.answered == false && request.resource.data.hidden == false
          && game(gameId).phase != 'finished';
        // oyunçu yalnız öz səsini əlavə edə/silə bilər
        allow update: if isGameHost(gameId) || (isPlayer(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes.toSet().difference(resource.data.votes.toSet()).union(resource.data.votes.toSet().difference(request.resource.data.votes.toSet())) == [request.auth.uid].toSet());
        allow delete: if isGameHost(gameId);
      }

      // Oyun sonu sual icmalı (düzgün cavablarla) — yalnız iştirakçılar və host
      match /results/{doc} {
        allow read: if isGameHost(gameId) || isPlayer(gameId);
        allow write: if isGameHost(gameId);
      }

      // Təlim sonu rəy sorğusu
      match /feedback/{uid} {
        allow delete: if isGameHost(gameId);
        allow read: if isGameHost(gameId);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rating','comment','name','at'])
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500))
          && request.resource.data.at == request.time
          && exists(/databases/$(db)/documents/games/$(gameId)/players/$(request.auth.uid));
      }
    }
  }
}
